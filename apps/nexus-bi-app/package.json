{
  "name": "nexus-bi-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:local:setup": "node scripts/setup-local-dev-db.mjs",
    "dev:local:teardown": "node scripts/teardown-local-dev-db.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
