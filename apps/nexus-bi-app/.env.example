# ==========================
# SUPABASE (runtime de la app -ver docs/RUNBOOK_SUPABASE_NETLIFY.md)
# ==========================
# Connection string del POOLER de Supabase (Supavisor, puerto 6543, modo
# transaction), rol nexus_app -NUNCA la conexión directa acá (Netlify/
# Vercel son serverless, agotarían el límite de conexiones de Supabase).
SUPABASE_DB_URL=

# Supabase Auth SSR. Ambas variables son públicas por diseño y deben estar
# disponibles en build y runtime de Netlify. Nunca usar service_role aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Allowlist server-only ID visible -> correo técnico. Los correos nunca se
# muestran en la UI ni se aceptan desde el navegador.
NEXUS_AUTH_GERENCIA_EMAIL=
NEXUS_AUTH_ADMINISTRACION_EMAIL=

# Auditoría y Explorador están pausados. Sólo "true" los muestra en el
# sidebar; las rutas permanecen protegidas aunque estén ocultas.
NEXUS_SHOW_AUDIT=false
NEXUS_SHOW_EXPLORER=false

# ==========================
# AUTH ADMIN (CRUD server-to-server -ver lib/auth.ts)
# ==========================
# Header esperado: x-nexus-admin-token. Generar con `openssl rand -hex 32`.
# SERVER-ONLY, SIN EXCEPCIÓN: nunca con prefijo NEXT_PUBLIC_, nunca leído
# desde un archivo "use client" -ver plan de migración § Fase 3.
NEXUS_ADMIN_TOKEN=

# ==========================
# FIELDBEAT "ABRIR EN FIELDBEAT" (Phase 6, riesgo aceptado 27.B - ver
# lib/fieldbeat-open-url.ts)
# ==========================
# SERVER-ONLY, SIN EXCEPCIÓN: nunca con prefijo NEXT_PUBLIC_, nunca
# expuestas en JSON/HTML/bundle de cliente ni en logs. El cliente solo
# recibe un booleano de disponibilidad (fieldbeatOpenAvailable) - jamás
# estos valores. Ambas deben estar presentes para que
# GET /api/dashboard/fieldbeat/reports/[id]/open redirija; si falta
# cualquiera, ese endpoint responde 503 sin indicar cuál falta.
#
# RIESGO ACEPTADO POR EL PROPIETARIO: tras el redirect, el token queda
# visible para el usuario autenticado en la barra de direcciones,
# historial del navegador y DevTools (es el propio header Location de la
# respuesta 302) - por diseño, no un descuido.
FIELDBEAT_FLEET=
FIELDBEAT_REPORT_TOKEN=
