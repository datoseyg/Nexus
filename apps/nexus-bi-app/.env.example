# ==========================
# TLS del runtime PostgreSQL (lib/db.ts - se aplica a SUPABASE_DB_URL y a
# TODAS las GOVERNANCE_*_DB_URL de abajo, misma lógica compartida, nunca
# duplicada por rol)
# ==========================
# verify-full: modo Cloud/runtime - verificación ESTRICTA de certificado Y
# hostname (nunca solo cifrado sin verificar identidad). Es el default si
# esta variable no está configurada -así un deployment que se olvidó de
# configurarla sigue verificando estricto, nunca cae a un modo más débil.
# disable: SOLO para Postgres local (localhost/127.0.0.1/::1) - cualquier
# otro host con disable es rechazado con error explícito.
DATABASE_SSL_MODE=verify-full

# Obligatoria cuando DATABASE_SSL_MODE=verify-full (irrelevante bajo
# disable). El PEM de la CA raíz (ej. la de Supabase), codificado en
# base64 - SERVER-ONLY, portable para Netlify (nunca una ruta de archivo
# local, que no existe en un runtime serverless). Nunca commitear un
# certificado real acá ni en ningún .env real - este archivo es solo
# plantilla.
DATABASE_SSL_CA_B64=

# ==========================
# SUPABASE (runtime de la app -ver docs/RUNBOOK_SUPABASE_NETLIFY.md)
# ==========================
# Connection string del POOLER de Supabase (Supavisor, puerto 6543, modo
# transaction), rol nexus_app -NUNCA la conexión directa acá (Netlify/
# Vercel son serverless, agotarían el límite de conexiones de Supabase).
# NUNCA incluir acá los parámetros sslmode/sslrootcert/sslcert/sslkey -
# node-postgres los usa para REEMPLAZAR el objeto ssl explícito que arma
# lib/db.ts a partir de DATABASE_SSL_MODE/DATABASE_SSL_CA_B64 de arriba, y
# el runtime rechaza el arranque si detecta cualquiera de ellos en la
# connection string (ver lib/db.ts::assertNoConnectionStringSslOverrides).
# El TLS se controla EXCLUSIVAMENTE desde esas dos variables, nunca desde
# la connection string.
SUPABASE_DB_URL=

# Supabase Auth SSR. Ambas variables son públicas por diseño y deben estar
# disponibles en build y runtime de Netlify. Nunca usar service_role aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Allowlist server-only ID visible -> correo técnico. Los correos nunca se
# muestran en la UI ni se aceptan desde el navegador.
NEXUS_AUTH_GERENCIA_EMAIL=
NEXUS_AUTH_ADMINISTRACION_EMAIL=

# ==========================
# GOVERNANCE (roles PostgreSQL dedicados, ver lib/governance-db.ts - Gate B
# B13/B34: la autorización real de cada operación de gobierno es el rol de
# conexión + su GRANT, nunca solo requireCapability()). Una URL por rol,
# NUNCA el mismo pool genérico de SUPABASE_DB_URL. En desarrollo local,
# generadas por scripts/set-local-governance-role-passwords.mjs; en
# Supabase, la contraseña real se fija en el dashboard. Mismo TLS
# compartido que SUPABASE_DB_URL (ver arriba) - ninguna de estas URLs debe
# tampoco incluir sslmode/sslrootcert/sslcert/sslkey.
# ==========================
GOVERNANCE_APP_READ_DB_URL=
GOVERNANCE_APP_CORRECTIONS_DB_URL=
GOVERNANCE_AUDIT_RESTRICTED_READ_DB_URL=
GOVERNANCE_COMMAND_ATTEMPT_LOGGER_DB_URL=
# NEXUS V3 - POST/GET /api/data-refresh/runs (pipeline.refresh_runs, sql/101).
GOVERNANCE_PIPELINE_REQUESTER_DB_URL=

# Auditoría y Explorador están pausados. Sólo "true" los muestra en el
# sidebar; las rutas permanecen protegidas aunque estén ocultas.
NEXUS_SHOW_AUDIT=false
NEXUS_SHOW_EXPLORER=false

# ==========================
# AUTH ADMIN (CRUD server-to-server -ver lib/auth.ts)
# ==========================
# Header esperado: x-nexus-admin-token. Generar con `openssl rand -hex 32`.
# SERVER-ONLY, SIN EXCEPCIÓN: nunca con prefijo NEXT_PUBLIC_, nunca leído
# desde un archivo "use client" -ver plan de migración § Fase 3.
NEXUS_ADMIN_TOKEN=

# ==========================
# FIELDBEAT "ABRIR EN FIELDBEAT" (Phase 6, riesgo aceptado 27.B - ver
# lib/fieldbeat-open-url.ts)
# ==========================
# SERVER-ONLY, SIN EXCEPCIÓN: nunca con prefijo NEXT_PUBLIC_, nunca
# expuestas en JSON/HTML/bundle de cliente ni en logs. El cliente solo
# recibe un booleano de disponibilidad (fieldbeatOpenAvailable) - jamás
# estos valores. Ambas deben estar presentes para que
# GET /api/dashboard/fieldbeat/reports/[id]/open redirija; si falta
# cualquiera, ese endpoint responde 503 sin indicar cuál falta.
#
# RIESGO ACEPTADO POR EL PROPIETARIO: tras el redirect, el token queda
# visible para el usuario autenticado en la barra de direcciones,
# historial del navegador y DevTools (es el propio header Location de la
# respuesta 302) - por diseño, no un descuido.
FIELDBEAT_FLEET=
FIELDBEAT_REPORT_TOKEN=
