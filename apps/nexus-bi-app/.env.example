# ==========================
# SUPABASE (runtime de la app — ver docs/RUNBOOK_SUPABASE_NETLIFY.md)
# ==========================
# Connection string del POOLER de Supabase (Supavisor, puerto 6543, modo
# transaction), rol nexus_app — NUNCA la conexión directa acá (Netlify/
# Vercel son serverless, agotarían el límite de conexiones de Supabase).
SUPABASE_DB_URL=

# ==========================
# AUTH ADMIN (CRUD server-to-server — ver lib/auth.ts)
# ==========================
# Header esperado: x-nexus-admin-token. Generar con `openssl rand -hex 32`.
# SERVER-ONLY, SIN EXCEPCIÓN: nunca con prefijo NEXT_PUBLIC_, nunca leído
# desde un archivo "use client" — ver plan de migración § Fase 3.
NEXUS_ADMIN_TOKEN=
