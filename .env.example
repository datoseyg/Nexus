# ==========================
# ZENDESK
# ==========================
ZENDESK_URL=
ZENDESK_USER=
ZENDESK_TOKEN=

# ==========================
# FIELDBEAT
# ==========================
FIELDBEAT_API_BASE_URL=
FIELDBEAT_API_USER=
FIELDBEAT_API_PASS=

# Para test local directo
FIELDBEAT_TASK_IDS=
FIELDBEAT_PAGE_SIZE=
FIELDBEAT_MAX_PAGES=
FIELDBEAT_DETAIL_CONCURRENCY=
FIELDBEAT_FETCH_DETAILS=

# ==========================
# DOLIBARR
# ==========================
DOLIBARR_URL=
DOLIBARR_TOKEN=

# ==========================
# SUPABASE (migración a Postgres -ver docs/RUNBOOK_SUPABASE_NETLIFY.md)
# ==========================
# Conexión DIRECTA (puerto 5432) -SOLO para los scripts de migración/DDL
# que corren una vez desde esta máquina (src/db/generate-postgres-ddl.js,
# src/db/migrate-to-supabase.js, src/db/validate-supabase.js). Nunca se usa
# desde la app desplegada.
SUPABASE_DB_URL_DIRECT=

# ==========================
# NEXUS V3 - actualización de datos orquestada (ver docs/data-refresh-runbook.md)
# ==========================
# Project ref esperado del proyecto Supabase V3 que apunta SUPABASE_DB_URL_DIRECT
# - scripts/pipeline/run-data-refresh.mjs aborta ANTES de escribir si no
# coincide (src/lib/db-safety.js::assertKnownSupabaseProject), para que un
# refresh nunca pueda sincronizar por error contra el proyecto Nexus V2.
SUPABASE_PROJECT_REF_V3=

# Roles de gobierno dedicados a pipeline.refresh_runs (sql/101) - SOLO
# necesarios para correr scripts/pipeline/run-data-refresh.mjs o
# scripts/pipeline/local-refresh-worker.mjs. En desarrollo local, generadas
# por scripts/set-local-governance-role-passwords.mjs (nunca a mano); en
# Supabase/GitHub Actions, la contraseña real se fija en el dashboard/en los
# secretos del Environment correspondiente (ver .github/workflows/data-refresh.yml).
GOVERNANCE_PIPELINE_REQUESTER_DB_URL=
GOVERNANCE_PIPELINE_WORKER_DB_URL=
GOVERNANCE_RULE_EVALUATOR_DB_URL=
